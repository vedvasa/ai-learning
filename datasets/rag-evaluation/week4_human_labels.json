        "expected_relevant_documents": [
          {
            "tenant_id": "knowledgedesk-demo",
            "document_key": "plan-limits-starter",
            "document_version": 1,
            "content_sha256": "f46087582c54e4b4d6b0ae5cee95d8c2639aff7a215ddd91dab1d66a45527ef8"
          },
          {
            "tenant_id": "knowledgedesk-demo",
            "document_key": "plan-limits-pro",
            "document_version": 1,
            "content_sha256": "96f9a702be603cddab24d736444f44606308a3ddd40090f674d6ae091d468516"
          }
        ],
        "key_answer_facts": [
          "The Starter plan supports up to five workspace members, three active automations, and 5 GB of attachment storage. It includes 30 days of audit history and community support. New members or automations cannot be added after a limit is reached. Existing automations continue to run unless a downgrade placed the workspace above the limit. Storage uploads are blocked when the allowance is full, but existing attachments remain readable.",
          "The Pro plan supports up to 50 workspace members, 100 active automations, and 100 GB of attachment storage. It includes one year of audit history and standard email support. Each Pro workspace can make 120 API requests per minute. Requests over the limit receive HTTP 429 with a retry hint. The allowance is shared by all API keys in the workspace rather than assigned to each key."
        ],
        "should_abstain": false,
        "category": "multi_document",
        "difficulty": "easy",
        "adversarial_notes": null,
        "label_provenance": {
          "origin": "human",
          "annotator_role": "project_owner",
          "labeled_on": "2026-09-03",
          "human_reviewed": true
