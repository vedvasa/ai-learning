        "expected_relevant_documents": [
          {
            "tenant_id": "knowledgedesk-demo",
            "document_key": "refunds-eligibility",
            "document_version": 1,
            "content_sha256": "c1c213d658f82f0fe18629a066640edce5d0be47bdfdaac8081b90b9fd402259"
          },
          {
            "tenant_id": "knowledgedesk-demo",
            "document_key": "refunds-timing",
            "document_version": 1,
            "content_sha256": "06ac99eb2df3b6f30b004cfd153b5b5fd13faf19acfe550bbaa46fb8c3a5b297"
          }
        ],
        "key_answer_facts": [
          "First-time subscription purchases may be eligible when the workspace owner contacts billing support within 14 calendar days of the charge.",
          "Refund approval is not automatic.",
          "After approval, the processor submits the refund to the original payment method.",
          "Card refunds commonly appear within five to ten business days; the financial institution controls the exact posting date."
        ],
        "should_abstain": false,
        "category": "multi_document",
        "difficulty": "medium",
        "adversarial_notes": null,
        "label_provenance": {
          "origin": "model_assisted",
          "annotator_role": "project_owner",
          "labeled_on": "2026-09-29",
          "human_reviewed": true
        }
      }
