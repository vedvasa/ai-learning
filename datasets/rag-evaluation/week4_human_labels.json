      "slot_number": 1,
      "label": {
        "case_id": "human-password-reset",
        "question": "How do I reset my password?",
        "context": {
          "tenant_id": "knowledgedesk-demo",
          "principal_id": "fictional-public-user",
          "principal_type": "anonymous",
          "allowed_visibilities": ["public"]
        },
        "expected_relevant_documents": [
          {
            "tenant_id": "knowledgedesk-demo",
            "document_key": "account-password-reset",
            "document_version": 1,
            "content_sha256": "68cf46608dee54db4e258115fd2d70ff55f5e5f3140b9fd2b08036c324a5e8af"
          }
        ],
        "key_answer_facts": [
          "Select Forgot password on the sign-in page and enter the email address attached to the account. KnowledgeDesk sends a single-use reset link when the account uses password authentication.",
          "Users whose workspace enforces SSO must reset credentials with their identity provider. KnowledgeDesk password reset emails are not sent for SSO-only accounts. A workspace administrator can confirm which sign-in method is required without seeing the user’s password."
        ],
        "should_abstain": false,
        "category": "direct_fact",
        "difficulty": "easy",
        "adversarial_notes": "KnowledgeDesk never sees a user's password. It never sends a temporary password.",
        "label_provenance": {
          "origin": "human",
          "annotator_role": "project_owner",
          "labeled_on": "2026-09-03",
          "human_reviewed": true
        }
      }
    },
    {
      "slot_number": 2,
      "label": {
        "case_id": "human-api-rate-limiting-policy",
        "question": "What's the API rate limiting policy?",
        "context": {
          "tenant_id": "knowledgedesk-demo",
          "principal_id": "fictional-member-user",
          "principal_type": "member",
          "allowed_visibilities": ["public", "internal", "restricted"]
        },
        "expected_relevant_documents": [
          {
            "tenant_id": "knowledgedesk-demo",
            "document_key": "api-rate-limits",
            "document_version": 1,
            "content_sha256": "56a5ad275797bbda0e8868a0f411de37b5649683e6d04f9f8a36d3970842d045"
          }
        ],
        "key_answer_facts": [
          "KnowledgeDesk Pro workspaces receive 120 requests per minute. A response with HTTP 429 means the current window has been exhausted.",
          "Clients should honor the Retry-After header and use exponential backoff with jitter."
        ],
        "should_abstain": false,
        "category": "direct_fact",
        "difficulty": "easy",
        "adversarial_notes": "Record the response request identifier in application logs and include it in support tickets. Do not log API keys, authorization headers, or full payloads containing customer data. Support can use the identifier to trace safe operational metadata.",
        "label_provenance": {
          "origin": "human",
          "annotator_role": "project_owner",
          "labeled_on": "2026-09-03",
          "human_reviewed": true
        }
      }
    },
