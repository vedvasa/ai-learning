# Application
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# LLM provider
LLM_PROVIDER=openai
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.25
LLM_RETRY_MAX_DELAY_SECONDS=2
LLM_RETRY_JITTER_RATIO=0.25
LLM_MAX_OUTPUT_TOKENS=64
TRIAGE_MAX_OUTPUT_TOKENS=256
MAX_MODEL_COST_USD_PER_REQUEST=0.05

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Supabase and database
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
